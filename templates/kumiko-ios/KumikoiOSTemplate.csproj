<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationId>com.example.kumikoiostemplate</ApplicationId>
    <ApplicationTitle>KumikoiOSTemplate</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AppIcon>AppIcon</AppIcon>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- Release device builds use NativeAOT: smaller bundles, faster startup, no runtime code generation. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'ios-arm64'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <!-- Debug simulator builds support `dotnet watch` hot reload. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseInterpreter>true</UseInterpreter>
    <MtouchLink>None</MtouchLink>
    <Registrar>dynamic</Registrar>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Kumiko.iOS" Version="0.2.0" />
  </ItemGroup>
</Project>
