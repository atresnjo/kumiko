<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><KumikoStrict>false</KumikoStrict>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;RS0026;RS0027</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Native immediate-mode desktop UI in C#.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../third_party/licenses/Yoga.Net-MIT.txt" Pack="true" PackagePath="third_party/licenses/" />
    <None Include="buildTransitive/Kumiko.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/Kumiko.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../Kumiko.Analyzers/bin/$(Configuration)/net10.0/Kumiko.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" />
    <None Include="../Kumiko.Analyzers/bin/$(Configuration)/net10.0/*.dll;../Kumiko.Analyzers/bin/$(Configuration)/net10.0/*.json" Pack="true" PackagePath="tools/net10.0/" />
  </ItemGroup>
  <Import Project="Metal.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- RS0026/RS0027 are overload-design rules; the declared files still track every overload. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI/**/PublicAPI.*.txt" />
  </ItemGroup>
</Project>
